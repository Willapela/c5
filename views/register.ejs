<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Criar conta · ConnectPlus C5G Panel</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-body">
    <div class="glass-container auth-box">
        <div class="logo-area">
            <div class="auth-mark">CP</div>
            <div class="auth-eyebrow">CONNECTPLUS C5G PANEL</div>
            <h2>Criar sua conta</h2>
            <p>Configure seu painel e obtenha uma URL personalizada.</p>
        </div>
        <% if (error) { %>
            <div class="alert error"><%= error %></div>
        <% } %>
        <form action="/register" method="POST">
            <div class="form-group">
                <label>Usuário (Apenas letras e números)</label>
                <input type="text" name="username" placeholder="seunome" required pattern="[a-zA-Z0-9]+">
            </div>
            <div class="form-group">
                <label>Senha</label>
                <input type="password" name="password" placeholder="••••••••" required>
            </div>
            <button type="submit" class="btn primary full-width">Criar conta</button>
        </form>
        <div class="auth-footer" style="text-align: center; margin-top: 1rem; font-size: 0.9rem; color: var(--text-muted);">
            Já tem uma conta? <a href="/login">Entrar</a>
        </div>
    </div>
</body>
</html>
