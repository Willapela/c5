<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ConnectPlus · C5G Panel</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <style>
        .color-control {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(15, 23, 42, 0.6);
            border: 1px solid var(--border-color);
            padding: 0.5rem 1rem;
            border-radius: 0.5rem;
            margin-bottom: 0.5rem;
        }
        .color-control label {
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.85rem;
            color: var(--text-primary);
            cursor: pointer;
        }
        .color-control input[type="color"] {
            border: none;
            width: 30px;
            height: 30px;
            border-radius: 4px;
            cursor: pointer;
            padding: 0;
            background: transparent;
        }
        .section-title {
            font-size: 1.1rem;
            color: var(--primary);
            margin: 1.5rem 0 1rem 0;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 0.5rem;
        }
    </style>
</head>
<body class="dashboard-body">

    <!-- Mobile Header -->
    <header class="mobile-header">
        <button class="menu-toggle mobile-menu-left" onclick="toggleSidebar()" aria-label="Abrir menu">☰</button>
        <div class="brand"><span class="brand-mark">CP</span><span>ConnectPlus</span></div>
        <span class="mobile-header-spacer" aria-hidden="true"></span>
    </header>

    <div id="app" style="display: flex; width: 100%;">
        
        <!-- Sidebar -->
        <aside class="sidebar" id="sidebar">
            <div class="brand" style="justify-content: space-between;">
                <div class="brand-name"><span class="brand-mark">CP</span><span>ConnectPlus</span></div>
                <button class="menu-toggle" style="display: none; padding-right:0;" onclick="toggleSidebar()" id="closeMenuBtn">✖</button>
            </div>
            
            <div class="menu-label">Painel de controle</div>
            <nav class="nav-menu">
                <div class="nav-item" :class="{active: activeMenu === 'dashboard'}" @click="setMenu('dashboard')">
                    <span class="nav-icon" aria-hidden="true">📊</span><span>Visão Geral</span>
                </div>
                <div class="nav-item" :class="{active: activeMenu === 'general'}" @click="setMenu('general')">
                    <span class="nav-icon" aria-hidden="true">⚙️</span><span>Configurações Gerais</span>
                </div>
                <div class="nav-item" :class="{active: activeMenu === 'layout'}" @click="setMenu('layout')">
                    <span class="nav-icon" aria-hidden="true">🎨</span><span>Layout e Cores</span>
                </div>
                <div class="nav-item" :class="{active: activeMenu === 'servers'}" @click="setMenu('servers')">
                    <span class="nav-icon" aria-hidden="true">🖥️</span><span>Servidores</span>
                </div>
                <div class="nav-item" :class="{active: activeMenu === 'cdn'}" @click="setMenu('cdn')">
                    <span class="nav-icon" aria-hidden="true">🌐</span><span>Pool CDN</span>
                </div>
                <div class="nav-item" :class="{active: activeMenu === 'raw'}" @click="setMenu('raw')">
                    <span class="nav-icon" aria-hidden="true">📝</span><span>Editor JSON Bruto</span>
                </div>
            </nav>
            
            <div class="sidebar-footer">
                <div class="user-profile">
                    <div class="avatar"><%= user.username.charAt(0).toUpperCase() %></div>
                    <div>
                        <div style="font-weight: 600; color: #fff;"><%= user.username %></div>
                        <div style="font-size: 0.8rem; color: var(--text-muted);">Administrador</div>
                    </div>
                </div>
                <a href="/logout" class="btn danger full-width small" style="margin-top: 0.5rem;">Sair</a>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            
            <!-- Dashboard Section -->
            <div v-show="activeMenu === 'dashboard'">
                <div class="page-header">
                    <div class="eyebrow">CENTRAL DE CONTROLE</div><h1 class="page-title">Visão Geral</h1>
                    <p class="text-muted">Gerencie suas configurações remotas.</p>
                </div>
                
                <div class="glass-container config-card" style="margin-bottom: 2rem;">
                    <h3 style="margin-bottom: 1rem; color: #fff;">Sua URL de Sincronização</h3>
                    <p class="text-muted" style="margin-bottom: 1rem;">Cole esta URL no campo "Update URL" do seu aplicativo Conecta5G para sincronizar as configurações.</p>
                    <div class="url-box" style="margin-bottom: .75rem;">
                        <input type="text" readonly value="<%= appUrl %>" id="configUrl">
                        <button onclick="copyUrl()" class="btn secondary">Copiar</button>
                    </div>
                    <p class="text-muted" style="margin: .5rem 0 0;">URL do appupdate, usada somente se o aplicativo solicitar atualização do APK:</p>
                    <div class="url-box" style="margin-bottom: .75rem;">
                        <input type="text" readonly value="<%= appUpdateUrl %>" id="appUpdateUrl">
                        <button onclick="copySpecificUrl('appUpdateUrl')" class="btn secondary">Copiar</button>
                    </div>
                    <p class="text-muted" style="margin: .5rem 0 0;">URL do tema do aplicativo:</p>
                    <div class="url-box" style="margin-bottom: .75rem;">
                        <input type="text" readonly value="<%= themeUrl %>" id="themeUrl">
                        <button onclick="copySpecificUrl('themeUrl')" class="btn secondary">Copiar</button>
                    </div>
                    <p class="text-muted" style="margin: .5rem 0 0;">URL do SMS do aplicativo:</p>
                    <div class="url-box" style="margin-bottom: 0;">
                        <input type="text" readonly value="<%= smsUrl %>" id="smsUrl">
                        <button onclick="copySpecificUrl('smsUrl')" class="btn secondary">Copiar</button>
                    </div>
                </div>

                <div class="card-grid">
                    <div class="config-card">
                        <h4 style="color: #fff; margin-bottom: 0.5rem;">Total de Servidores</h4>
                        <div style="font-size: 2.5rem; font-weight: 700; color: var(--primary);">{{ config.Servers.length }}</div>
                    </div>
                    <div class="config-card">
                        <h4 style="color: #fff; margin-bottom: 0.5rem;">Versão da Config</h4>
                        <div style="font-size: 2.5rem; font-weight: 700; color: #10b981;">v{{ config.Version }}</div>
                    </div>
                </div>
            </div>

            <!-- General Section -->
            <div v-show="activeMenu === 'general'">
                <div class="page-header">
                    <div class="eyebrow">CONFIGURAÇÃO GLOBAL</div><h1 class="page-title">Configurações Gerais</h1>
                    <p class="text-muted">Configurações globais do aplicativo.</p>
                </div>
                
                <div class="glass-container config-card">
                    <div class="card-grid form-grid-2">
                        <div class="form-group">
                            <label>Versão da configuração</label>
                            <input type="number" v-model="config.Version" min="1">
                            <small class="text-muted">Aumente a versão para o ConnectPlus buscar uma nova configuração.</small>
                        </div>
                        <div class="form-group">
                            <label>Porta UDP</label>
                            <input type="text" v-model="config.UdpPort" placeholder="7300">
                        </div>
                        <div class="form-group">
                            <label>Contato</label>
                            <input type="url" v-model="config.Contato" placeholder="https://t.me/seu_canal">
                        </div>
                        <div class="form-group">
                            <label>Site</label>
                            <input type="url" v-model="config.Site" placeholder="https://www.speedtest.net">
                        </div>
                        <div class="form-group full-width">
                            <label>URL da configuração</label>
                            <input type="text" value="<%= appUrl %>" readonly style="background-color: rgba(255,255,255,0.05); color: #9fc5ff; cursor: not-allowed;">
                            <small class="text-muted">Gerada automaticamente para o seu usuário e entregue no formato ConnectPlus.</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CDN Pool Section -->
            <div v-show="activeMenu === 'cdn'">
                <div class="page-header">
                    <div class="eyebrow">TESTE DE DISPONIBILIDADE</div><h1 class="page-title">Pool CDN</h1>
                    <p class="text-muted">Teste domínios e URLs da CDN antes de usar no ProxyIP ou XHTTP.</p>
                </div>
                <div class="glass-container config-card">
                    <div class="form-group">
                        <label>Links ou domínios</label>
                        <textarea v-model="cdnInput" rows="5" placeholder="oc3xhkzwdcw.map.azionedge.net\nhttps://exemplo.com/cdn"></textarea>
                        <small class="text-muted">Informe um por linha ou separados por vírgula. Serão testados no máximo 100 links.</small>
                    </div>
                    <div class="card-grid form-grid-2">
                        <button class="btn secondary" @click="saveCdnPool">💾 Salvar pool</button>
                        <button class="btn primary" @click="testCdnPool" :disabled="cdnTesting">{{ cdnTesting ? 'Testando...' : '⚡ Testar links' }}</button>
                    </div>
                </div>
                <div v-if="cdnResults.length" class="glass-container config-card">
                    <div style="display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;">
                        <div><h3 class="section-title" style="margin-top:0;">Resultado dos testes</h3><p class="text-muted">{{ cdnActive.length }} link(s) ativo(s) de {{ cdnResults.length }}.</p></div>
                        <button class="btn secondary small" @click="copyActiveCdn">📋 Copiar ativos</button>
                    </div>
                    <div class="list-container">
                        <div class="list-item" v-for="item in cdnResults" :key="item.url">
                            <div class="list-item-content"><div class="list-item-title">{{ item.url }}</div><div class="list-item-subtitle">{{ item.host || item.error || 'Sem resposta' }} · {{ item.latency }} ms · HTTP {{ item.status || '—' }}</div></div>
                            <span :style="{color: item.online ? '#34d399' : '#fb7185', fontWeight: '700'}">{{ item.online ? 'ONLINE' : 'OFFLINE' }}</span>
                        </div>
                    </div>
                </div>
                <div v-else-if="cdnPool.length" class="glass-container config-card"><p class="text-muted">{{ cdnPool.length }} link(s) salvo(s). Clique em “Testar links” para verificar.</p></div>
            </div>

            <!-- Layout Section -->
            <div v-show="activeMenu === 'layout'">
                <div class="page-header">
                    <div class="eyebrow">IDENTIDADE VISUAL</div><h1 class="page-title">Layout e Cores</h1>
                    <p class="text-muted">Personalize links, imagens e cores do aplicativo.</p>
                </div>
                
                <div class="glass-container config-card">
                    <h3 class="section-title" style="margin-top:0;">Tema do aplicativo ConnectPlus</h3>
                    <p class="text-muted">Estrutura compatível com o tema enviado para o ConnectPlus.</p>
                    <div class="card-grid">
                        <div class="form-group"><label>Nome do aplicativo</label><input type="text" v-model="config.Theme.AppName" readonly value="ConnectPlus" style="background-color: rgba(255,255,255,0.05); color: #888; cursor: not-allowed;"></div>
                        <div class="form-group"><label>Versão do tema</label><input type="text" v-model="config.Theme.Version"></div>
                        <div class="form-group"><label>URL do tema</label><input type="text" v-model="config.Theme.Update" readonly style="background-color: rgba(255,255,255,0.05); color: #888; cursor: not-allowed;"></div>
                        <div class="form-group"><label>Imagem de fundo</label><input type="url" v-model="config.Theme.ImgFundo"></div>
                        <div class="form-group"><label>Logo</label><input type="url" v-model="config.Theme.ImgLogo"></div>
                        <div class="form-group"><label>Banner</label><input type="url" v-model="config.Theme.ImgBanner"></div>
                        <div class="form-group"><label>Imagem do menu</label><input type="url" v-model="config.Theme.ImgMenu"></div>
                        <div class="form-group"><label>Imagem dos logs</label><input type="url" v-model="config.Theme.ImgLogs"></div>
                        <div class="form-group"><label>Imagem de check</label><input type="url" v-model="config.Theme.ImgCheck"></div>
                        <div class="form-group"><label>Imagem do usuário</label><input type="url" v-model="config.Theme.ImgUser"></div>
                        <div class="form-group"><label>Imagem da senha</label><input type="url" v-model="config.Theme.ImgPass"></div>
                        <div class="form-group"><label>Imagem de atualização</label><input type="url" v-model="config.Theme.ImgUpdate"></div>
                        <div class="form-group"><label>ColorOne</label><input type="text" v-model="config.Theme.ColorOne"></div>
                        <div class="form-group"><label>ColorTwo</label><input type="text" v-model="config.Theme.ColorTwo"></div>
                        <div class="form-group"><label>ColorStarter</label><input type="text" v-model="config.Theme.ColorStarter"></div>
                        <div class="form-group"><label>ColorDialogs</label><input type="text" v-model="config.Theme.ColorDialogs"></div>
                        <div class="form-group"><label>ColorButtons</label><input type="text" v-model="config.Theme.ColorButtons"></div>
                    </div>

                </div>
            </div>

            <!-- Servers Section -->
            <div v-show="activeMenu === 'servers'">
                <div class="page-header" style="display: flex; justify-content: space-between; align-items: center;">
                    <div>
                        <div class="eyebrow">CONNECTPLUS</div><h1 class="page-title">Servidores</h1>
                        <p class="text-muted">Gerencie seus servidores e IPs.</p>
                    </div>
                    <button class="btn primary" @click="addServer">＋ Novo Servidor</button>
                </div>
                
                <div class="list-container">
                    <div class="list-item" v-for="(srv, index) in config.Servers" :key="index" @click="editItem('Servers', index)">
                        <div class="list-item-content">
                            <div class="list-item-title">{{ srv.Name || 'Servidor Sem Nome' }}</div>
                            <div class="list-item-subtitle">{{ srv.ServerIP }} : {{ srv.ServerPort }} &nbsp;|&nbsp; {{ srv.Info || srv.TYPE || 'Sem modo' }}</div>
                        </div>
                        <div class="list-item-actions">
                            <button class="action-icon-btn danger" @click.stop="removeServer(index)" title="Excluir">✖</button>
                        </div>
                    </div>
                    
                    <div v-if="config.Servers.length === 0" class="text-muted" style="text-align: center; padding: 2rem;">
                        Nenhum servidor encontrado. Clique em "Novo Servidor" para adicionar.
                    </div>
                </div>
            </div>

            <!-- Raw JSON Section -->
            <div v-show="activeMenu === 'raw'">
                <div class="page-header">
                    <div class="eyebrow">MODO AVANÇADO</div><h1 class="page-title">Editor JSON</h1>
                    <p class="text-muted">Editor avançado para desenvolvedores e ajustes manuais.</p>
                </div>
                <textarea id="jsonEditor" spellcheck="false" :value="jsonString" @input="updateFromJson"></textarea>
            </div>

            <!-- Modal for Editing Server/Network -->
            <div class="modal-overlay" v-if="modal.isOpen" @click.self="closeModal">
                <div class="modal-content">
                    <div class="modal-header">
                        <h3>Configuração de Servidor</h3>
                        <button class="modal-close" @click="closeModal">✖</button>
                    </div>
                    <div class="modal-body">
                        
                        <!-- Server Edit Fields -->
                        <div v-if="modal.type === 'Servers' && config.Servers[modal.index]" class="server-form">
                            <div class="form-group">
                                <label>Modo de conexão</label>
                                <select v-model="config.Servers[modal.index].Info" @change="onConnectionModeChange">
                                    <option v-for="mode in connectionModes" :key="mode" :value="mode">{{ mode }}</option>
                                </select>
                                <div class="text-muted" style="margin-top: .5rem; line-height: 1.45;">
                                    {{ modeDescriptions[config.Servers[modal.index].Info] }}
                                </div>
                            </div>
                            <div class="form-group grid-col-2">
                                <div>
                                    <label>Nome</label>
                                    <input type="text" v-model="config.Servers[modal.index].Name" placeholder="WILL">
                                </div>
                                <div>
                                    <label>Descrição</label>
                                    <input type="text" v-model="config.Servers[modal.index].Description" placeholder="T1M 01">
                                </div>
                            </div>
                            <div class="form-group grid-col-2">
                                <div>
                                    <label>IP / Host do Servidor</label>
                                    <input type="text" v-model="config.Servers[modal.index].ServerIP">
                                </div>
                                <div>
                                    <label>Porta do Servidor</label>
                                    <input type="text" v-model="config.Servers[modal.index].ServerPort" placeholder="443">
                                </div>
                            </div>
                            <div class="form-group grid-col-2">
                                <div>
                                    <label>FLAG (URL)</label>
                                    <input type="text" v-model="config.Servers[modal.index].FLAG" placeholder="https://.../bandeira.png">
                                </div>
                                <div>
                                    <label>URL Check User</label>
                                    <input type="text" v-model="config.Servers[modal.index].CheckUser" placeholder="http://.../check?user={user}">
                                </div>
                            </div>
                            <div class="form-group grid-col-2">
                                <div>
                                    <label>Usuário</label>
                                    <input type="text" v-model="config.Servers[modal.index].USER">
                                </div>
                                <div>
                                    <label>Senha</label>
                                    <input type="password" v-model="config.Servers[modal.index].PASS">
                                </div>
                            </div>
                            <div v-if="['Direct','Proxy','Tlsws'].includes(config.Servers[modal.index].Info)" class="form-group grid-col-2">
                                <div class="grid-col-full">
                                    <label>Payload</label>
                                    <textarea v-model="config.Servers[modal.index].Payload" placeholder="GET /app8 HTTP/1.1[lf]Host: dominio.com[lf]Upgrade: websocket[lf][lf]"></textarea>
                                    <small class="text-muted">Use [lf] para quebra de linha. O app usa exatamente o texto informado.</small>
                                </div>
                            </div>
                            <div v-if="['Proxy','Tlsws','XHTTP'].includes(config.Servers[modal.index].Info)" class="form-group grid-col-2">
                                <div>
                                    <label>ProxyIP / Host</label>
                                    <input type="text" v-model="config.Servers[modal.index].ProxyIP" placeholder="IP ou host; use # para múltiplos">
                                    <small class="field-help">Para rotação, separe vários proxies com <code>#</code>. No XHTTP, pode ser um domínio, como <code>oc3xhkzwdcw.map.azionedge.net</code>.</small>
                                </div>
                                <div>
                                    <label>ProxyPort <span v-if="config.Servers[modal.index].Info === 'XHTTP'">(opcional)</span></label>
                                    <input type="text" v-model="config.Servers[modal.index].ProxyPort" placeholder="443">
                                </div>
                            </div>
                            <div v-if="['Ssl','Tlsws','XHTTP'].includes(config.Servers[modal.index].Info)" class="form-group">
                                <label>SNI</label>
                                <input type="text" v-model="config.Servers[modal.index].SNI" placeholder="app.tim.com.br">
                                <small v-if="config.Servers[modal.index].Info === 'XHTTP'" class="field-help">No XHTTP, informe o domínio SNI usado pelo servidor.</small>
                            </div>
                            <div v-if="config.Servers[modal.index].Info === 'XHTTP'" class="form-group">
<label>Path</label>
                                <input type="text" v-model="config.Servers[modal.index].Path" placeholder="/ssh">
                                    <small class="field-help">No XHTTP, use o caminho configurado pelo servidor, por exemplo <code>/ssh</code>.</small>
                            </div>
                            <div class="form-group grid-col-2">
                                <div>
                                    <label>ColorName</label>
                                    <input type="text" v-model="config.Servers[modal.index].ColorName" placeholder="#ffffff">
                                </div>
                                <div>
                                    <label>ColorDescription</label>
                                    <input type="text" v-model="config.Servers[modal.index].ColorDescription" placeholder="#ffffff">
                                </div>
                            </div>
                            <div class="form-group grid-col-2">
                                <div>
                                    <label>Color</label>
                                    <input type="text" v-model="config.Servers[modal.index].Color" placeholder="#0000ff">
                                </div>
                                <div>
                                    <label>Versão TLS</label>
                                    <select v-model="config.Servers[modal.index].TLSVersion">
                                        <option value="TLSv1.3">TLSv1.3</option>
                                        <option value="TLSv1.2">TLSv1.2</option>
                                        <option value="TLSv1.1">TLSv1.1</option>
                                    </select>
                                </div>
                            </div>
                        </div>


                    </div>
                    <div class="modal-footer">
                        <button class="btn primary" @click="closeModal">Concluir</button>
                    </div>
                </div>
            </div>

        </main>

        <!-- Floating Save Bar (fora do main para não sumir no desktop) -->
        <div class="floating-save-bar">
            <div class="floating-save-inner">
                <span v-if="saveStatus" class="save-status">{{ saveStatus }}</span>
                <button @click="saveConfig" :disabled="isSaving" class="btn primary full-width-mobile">
                    {{ isSaving ? 'Salvando...' : 'Salvar Configurações' }}
                </button>
            </div>
        </div>
    </div>

    <script>
        const initialConfig = <%- configStr %>;

        const appUrl = "<%= appUrl %>";

        const { createApp } = Vue;

        createApp({
            data() {
                if (!initialConfig.Networks) initialConfig.Networks = [];
                if (!initialConfig.Servers) initialConfig.Servers = [];

                // Modelo exclusivo do ConnectPlus: somente estas chaves são entregues ao app.
                const serverDefaults = {
                    Name: '', ColorName: '#ffffff', Description: '', ColorDescription: '#ffffff',
                    FLAG: '', ServerIP: '', ServerPort: '443', CheckUser: '', USER: '', PASS: '',
                    Payload: '', ProxyIP: '', ProxyPort: '443', SNI: '', Path: '', TLSVersion: 'TLSv1.2',
                    Color: '#0000ff', Info: 'Tlsws'
                };
                const connectPlusKeys = Object.keys(serverDefaults);
                initialConfig.Servers = initialConfig.Servers.map(server => {
                    const normalized = {};
                    connectPlusKeys.forEach(key => { normalized[key] = server[key] ?? serverDefaults[key]; });
                    normalized.Info = ['Ssl', 'Direct', 'Proxy', 'Tlsws', 'XHTTP'].includes(server.Info)
                        ? server.Info : (['Ssl', 'Direct', 'Proxy', 'Tlsws', 'XHTTP'].includes(server.TYPE) ? server.TYPE : 'Tlsws');
                    return normalized;
                });
                
                initialConfig.Update = appUrl;
                initialConfig.UdpPort = String(initialConfig.UdpPort ?? '7300');
                initialConfig.Contato = initialConfig.Contato ?? '';
                initialConfig.Site = initialConfig.Site ?? '';
                initialConfig.Theme = Object.assign({
                    Version: '1', Update: '', AppName: 'ConnectPlus', ImgFundo: '', ImgLogo: '', ImgBanner: '',
                    ImgMenu: '', ImgLogs: '', ImgCheck: '', ImgUser: '', ImgPass: '', ColorOne: '#7A333333',
                    ColorTwo: '#7A333333', ColorStarter: '#7A333333', ColorDialogs: '#84ffffff',
                    ColorButtons: '#333333', ImgUpdate: ''
                }, initialConfig.Theme || {});
                initialConfig.Theme.AppName = 'ConnectPlus';

                // Delete the fake Layout object if it was accidentally created before
                if (initialConfig.Layout) delete initialConfig.Layout;
                
                return {
                    activeMenu: localStorage.getItem('activeMenu') || 'dashboard',
                    connectionModes: [
                        'Ssl', 'Direct', 'Proxy', 'Tlsws', 'XHTTP'
                    ],
                    modeDescriptions: {
                        Ssl: 'SSL direto: o app usa ServerIP, ServerPort e SNI, sem proxy personalizado.',
                        Direct: 'Direct: conexão direta; o app usa ServerIP, ServerPort e Payload.',
                        Proxy: 'Proxy: o app usa ServerIP, ServerPort, ProxyIP, ProxyPort e Payload.',
                        Tlsws: 'Tlsws: o app usa servidor, porta, proxy, payload e SNI.',
                        XHTTP: 'XHTTP: o app usa servidor, porta, proxy, SNI e Path. O padrão de Path é /ssh.'
                    },
                    config: initialConfig,
                    cdnPool: [],
                    cdnInput: '',
                    cdnResults: [],
                    cdnActive: [],
                    cdnTesting: false,
                    modal: {
                        isOpen: false,
                        type: '',
                        index: -1
                    },
                    isSaving: false,
                    saveStatus: ''
                }
            },
            mounted() {
                this.loadCdnPool();
            },
            computed: {
                jsonString() {
                    return JSON.stringify(this.config, null, 4);
                }
            },
            methods: {
                setMenu(menu) {
                    this.activeMenu = menu;
                    localStorage.setItem('activeMenu', menu);
                    if (window.innerWidth <= 768) {
                        toggleSidebar();
                    }
                },
                async loadCdnPool() {
                    try {
                        const response = await fetch('/api/cdn-pool');
                        const data = await response.json();
                        this.cdnPool = data.urls || [];
                        this.cdnInput = this.cdnPool.join('\n');
                    } catch (e) {
                        this.cdnPool = [];
                    }
                },
                async saveCdnPool() {
                    const urls = this.cdnInput.split(/[\n,]+/).map(item => item.trim()).filter(Boolean);
                    const response = await fetch('/api/cdn-pool', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({ urls }) });
                    const data = await response.json();
                    this.cdnPool = data.urls || [];
                    this.cdnInput = this.cdnPool.join('\n');
                    this.saveStatus = '✅ Pool CDN salvo!';
                    setTimeout(() => { this.saveStatus = ''; }, 2500);
                },
                async testCdnPool() {
                    this.cdnTesting = true;
                    try {
                        const urls = this.cdnInput.split(/[\n,]+/).map(item => item.trim()).filter(Boolean);
                        const response = await fetch('/api/cdn-pool/test', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({ urls }) });
                        const data = await response.json();
                        this.cdnResults = data.results || [];
                        this.cdnActive = data.active || [];
                    } finally {
                        this.cdnTesting = false;
                    }
                },
                async copyActiveCdn() {
                    if (!this.cdnActive.length) return alert('Nenhum link ativo encontrado. Teste o pool primeiro.');
                    // Copia sem protocolo (sem https:// ou http://), separado por #
                    const text = this.cdnActive
                        .map(url => String(url || '').replace(/^https?:\/\//i, ''))
                        .filter(Boolean)
                        .join('#');
                    let copied = false;
                    try {
                        if (navigator.clipboard && window.isSecureContext) {
                            await navigator.clipboard.writeText(text);
                            copied = true;
                        }
                    } catch (error) {
                        copied = false;
                    }
                    if (!copied) {
                        const helper = document.createElement('textarea');
                        helper.value = text;
                        helper.setAttribute('readonly', '');
                        helper.style.position = 'fixed';
                        helper.style.left = '-9999px';
                        helper.style.top = '0';
                        document.body.appendChild(helper);
                        helper.focus();
                        helper.select();
                        helper.setSelectionRange(0, helper.value.length);
                        try { copied = document.execCommand('copy'); } catch (error) { copied = false; }
                        helper.remove();
                    }
                    if (copied) {
                        this.saveStatus = '✅ Links ativos copiados!';
                        setTimeout(() => { this.saveStatus = ''; }, 2500);
                    } else {
                        window.prompt('Copie manualmente os links ativos:', text);
                    }
                },
                async saveConfig() {
                    this.isSaving = true;
                    this.saveStatus = '';
                    try {
                        const response = await fetch('/dashboard/save', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ config_json: this.jsonString })
                        });
                        if (response.ok) {
                            this.saveStatus = '✅ Salvo com sucesso!';
                            setTimeout(() => { this.saveStatus = ''; }, 3000);
                        } else {
                            alert('Erro ao salvar as configurações no servidor.');
                        }
                    } catch (e) {
                        alert('Erro de conexão ao tentar salvar.');
                    } finally {
                        this.isSaving = false;
                    }
                },
                updateFromJson(e) {
                    try {
                        this.config = JSON.parse(e.target.value);
                    } catch(err) {
                        // ignore parsing errors while typing
                    }
                },
                editItem(type, index) {
                    this.modal.type = type;
                    this.modal.index = index;
                    this.modal.isOpen = true;
                },
                closeModal() {
                    this.modal.isOpen = false;
                },
                onConnectionModeChange() {
                    const server = this.config.Servers[this.modal.index];
                    if (!server) return;
                    if (server.Info === 'XHTTP') {
                        server.Payload = '';
                        if (server.ProxyPort === '443') server.ProxyPort = '';
                    }
                },
                addServer() {
                    this.config.Servers.push({
                        Name: "Nova Configuração",
                        ColorName: "#ffffff",
                        Description: "",
                        ColorDescription: "#ffffff",
                        FLAG: "",
                        ServerIP: "",
                        ServerPort: "443",
                        CheckUser: "",
                        USER: "",
                        PASS: "",
                        Payload: "",
                        ProxyIP: "",
                        ProxyPort: "443",
                        SNI: "",
                        Path: "",
                        TLSVersion: "TLSv1.2",
                        Color: "#0000ff",
                        Info: "Tlsws"
                    });
                    this.editItem('Servers', this.config.Servers.length - 1);
                },
                removeServer(idx) {
                    if (confirm("Tem certeza que deseja excluir este servidor?")) {
                        this.config.Servers.splice(idx, 1);
                    }
                },
            }
        }).mount('#app')

        function copySpecificUrl(id) {
            var copyText = document.getElementById(id);
            copyText.select();
            copyText.setSelectionRange(0, 99999);
            document.execCommand("copy");
            const btn = copyText.parentElement.querySelector('.btn');
            btn.textContent = 'Copiado!';
            setTimeout(() => btn.textContent = 'Copiar', 2000);
        }

        function copyUrl() {
            copySpecificUrl('configUrl');
        }

        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const closeBtn = document.getElementById('closeMenuBtn');
            sidebar.classList.toggle('open');
            if(window.innerWidth <= 768) {
                closeBtn.style.display = sidebar.classList.contains('open') ? 'block' : 'none';
            }
        }
        
        window.addEventListener('resize', () => {
            const closeBtn = document.getElementById('closeMenuBtn');
            if(window.innerWidth > 768) {
                document.getElementById('sidebar').classList.remove('open');
                closeBtn.style.display = 'none';
            }
        });
    </script>
</body>
</html>
