<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nova senha · ConnectPlus C5G Panel</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-body">
    <div class="glass-container auth-box">
        <div class="logo-area">
            <div class="auth-mark">CP</div>
            <div class="auth-eyebrow">CONNECTPLUS PANEL</div>
            <h2>Definir nova senha</h2>
            <p>Escolha uma nova senha para acessar sua conta.</p>
        </div>
        <% if (error) { %>
            <div class="alert error"><%= error %></div>
        <% } %>
        <% if (message) { %>
            <div class="alert" style="border-color: rgba(52,211,153,.35); color:#a7f3d0;"><%= message %></div>
        <% } %>
        <% if (token) { %>
            <form action="/reset-password" method="POST">
                <input type="hidden" name="token" value="<%= token %>">
                <div class="form-group">
                    <label>Nova senha</label>
                    <input type="password" name="password" placeholder="••••••••" required minlength="6" autocomplete="new-password">
                </div>
                <div class="form-group">
                    <label>Confirmar nova senha</label>
                    <input type="password" name="confirmPassword" placeholder="••••••••" required minlength="6" autocomplete="new-password">
                </div>
                <button type="submit" class="btn primary full-width">Salvar nova senha</button>
            </form>
        <% } %>
        <div class="auth-footer" style="text-align:center; margin-top:1rem; font-size:.9rem; color:var(--text-muted);">
            <a href="/login">Voltar para o login</a>
        </div>
    </div>
</body>
</html>
